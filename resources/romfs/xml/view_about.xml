<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20px"
    paddingLeft="35px"
    paddingRight="35px"
    paddingBottom="15px">

    <!-- Encabezado estilo Switch Horizon OS con barra elegante -->
    <brls:Box
        width="100%"
        height="auto"
        axis="column"
        marginBottom="16px">
        <brls:Label
            text="@i18n/hints/about_title"
            fontSize="24px"
            textColor="@theme/brls/text"
            marginBottom="12px" />
        <brls:Box
            width="100%"
            height="1px"
            backgroundColor="@theme/brls/sidebar/separator" />
    </brls:Box>

    <brls:ScrollingFrame
        width="auto"
        height="560px">
        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            justifyContent="spaceBetween"
            paddingBottom="30px">

            <!-- Columna Izquierda: Información de la Aplicación y Desarrollador -->
            <brls:Box
                width="660px"
                height="auto"
                axis="column"
                padding="24px"
                cornerRadius="8px"
                backgroundColor="@theme/brls/sidebar/background"
                marginRight="20px">

                <brls:Box
                    width="auto"
                    height="auto"
                    axis="row"
                    alignItems="center"
                    marginBottom="18px">
                    <brls:Image
                        image="@res/img/ezfiles_logo.png"
                        width="80px"
                        height="80px"
                        cornerRadius="16px"
                        marginRight="18px" />
                    <brls:Box
                        width="auto"
                        height="auto"
                        axis="column">
                        <brls:Label
                            text="FileZzz"
                            fontSize="26px"
                            textColor="#00E6A8" />
                        <brls:Label
                            text="@i18n/hints/about_version"
                            fontSize="14px"
                            textColor="@theme/brls/text_disabled"
                            marginTop="4px" />
                    </brls:Box>
                </brls:Box>

                <brls:Box
                    width="100%"
                    height="1px"
                    backgroundColor="@theme/brls/sidebar/separator"
                    marginBottom="16px" />

                <brls:Label
                    text="@i18n/hints/about_developer"
                    fontSize="16px"
                    textColor="@theme/brls/text"
                    marginBottom="8px" />

                <brls:Label
                    text="@i18n/hints/about_email"
                    fontSize="15px"
                    textColor="#00E6A8"
                    marginBottom="8px" />

                <brls:Label
                    text="@i18n/hints/about_paypal"
                    fontSize="15px"
                    textColor="#00E6A8"
                    marginBottom="8px" />

                <brls:Label
                    text="@i18n/hints/about_coffee"
                    fontSize="15px"
                    textColor="#00E6A8"
                    marginBottom="8px" />

                <brls:Label
                    text="@i18n/hints/about_repo"
                    fontSize="15px"
                    textColor="@theme/brls/text"
                    marginBottom="8px" />

                <brls:Label
                    text="@i18n/hints/about_engine"
                    fontSize="14px"
                    textColor="@theme/brls/text_disabled"
                    marginBottom="20px" />

                <!-- Botón Buscar Actualizaciones -->
                <brls:Box
                    id="btnCheckUpdates"
                    width="260px"
                    height="46px"
                    focusable="true"
                    cornerRadius="4px"
                    backgroundColor="#2A2E39"
                    justifyContent="center"
                    alignItems="center">
                    <brls:Label
                        text="@i18n/hints/about_check_updates"
                        fontSize="16px"
                        textColor="#00E6A8" />
                </brls:Box>

            </brls:Box>

            <!-- Divisor vertical -->
            <brls:Box
                width="1px"
                height="440px"
                backgroundColor="@theme/brls/sidebar/separator"
                marginRight="20px" />

            <!-- Columna Derecha: Donaciones y Apoyo (PayPal) -->
            <brls:Box
                width="440px"
                height="auto"
                axis="column"
                alignItems="center"
                padding="24px"
                cornerRadius="8px"
                backgroundColor="@theme/brls/sidebar/background">

                <brls:Label
                    text="@i18n/hints/about_support"
                    fontSize="20px"
                    textColor="@theme/brls/text"
                    marginBottom="6px" />

                <brls:Label
                    text="paypal.me/francopaololg"
                    fontSize="15px"
                    textColor="#00E6A8"
                    marginBottom="14px" />

                <!-- Contenedor QR de donaciones -->
                <brls:Box
                    id="boxCoffeeQr"
                    width="230px"
                    height="230px"
                    cornerRadius="8px"
                    justifyContent="center"
                    alignItems="center"
                    backgroundColor="#2A2E39"
                    marginBottom="14px" />

                <brls:Label
                    text="@i18n/hints/about_scan_qr"
                    fontSize="13px"
                    textColor="@theme/brls/text_disabled"
                    width="320px" />

            </brls:Box>

        </brls:Box>
    </brls:ScrollingFrame>

</brls:Box>
