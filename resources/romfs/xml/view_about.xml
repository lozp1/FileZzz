<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20px"
    paddingLeft="40px"
    paddingRight="40px"
    paddingBottom="20px">

    <brls:Header
        title="Acerca de EzFiles" />
    <brls:Label
        text="Gestor de archivos y servidor de transferencia avanzado para Nintendo Switch"
        fontSize="15px"
        textColor="#9CA3AF"
        marginTop="4px" />

    <brls:ScrollingFrame
        width="auto"
        height="500px"
        marginTop="20px">
        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="center">

            <brls:Image
                image="@res/img/icon_explorer.png"
                width="96px"
                height="96px"
                marginTop="10px"
                marginBottom="12px" />

            <brls:Label
                text="EzFiles"
                fontSize="28px"
                textColor="#06B6D4" />

            <brls:Label
                text="Version 1.3.0 (Borealis Native UI)"
                fontSize="16px"
                textColor="#10B981"
                marginTop="4px" />

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                marginTop="20px"
                padding="20px"
                cornerRadius="8px"
                backgroundColor="#1A1D24">

                <brls:Header
                    title="Informacion General" />

                <brls:Label
                    text="Desarrollado por: Paolo"
                    fontSize="15px"
                    textColor="#E5E7EB"
                    marginTop="6px" />

                <brls:Label
                    text="EzFiles es una suite integral de gestion de archivos, servidor de transferencia MTP USB de alta velocidad y servidor FTP inalambrico optimizada para Horizon OS."
                    fontSize="14px"
                    textColor="#9CA3AF"
                    marginTop="6px" />

                <brls:Header
                    title="Caracteristicas y Modulos"
                    marginTop="18px" />

                <brls:Label
                    text="- Explorador de archivos nativo con portapapeles (Copiar, Cortar, Pegar), renombrado y borrado seguro."
                    fontSize="14px"
                    textColor="#D1D5DB"
                    marginTop="6px" />

                <brls:Label
                    text="- Servidor USB MTP de alto rendimiento (35 - 45 MB/s) con 8 particiones estructuradas al estilo DBI."
                    fontSize="14px"
                    textColor="#D1D5DB"
                    marginTop="6px" />

                <brls:Label
                    text="- Servidor FTP Wi-Fi multihilo compatible con clientes estandar (FileZilla, WinSCP, Windows Explorer)."
                    fontSize="14px"
                    textColor="#D1D5DB"
                    marginTop="6px" />

                <brls:Label
                    text="- Motor grafico Borealis con aceleracion por hardware OpenGL y renderizado fluido a 60 FPS."
                    fontSize="14px"
                    textColor="#D1D5DB"
                    marginTop="6px" />

                <brls:Header
                    title="Controles y Atajos de Teclado"
                    marginTop="18px" />

                <brls:Label
                    text="- [A] / Touch: Seleccionar / Entrar a carpeta"
                    fontSize="14px"
                    textColor="#9CA3AF"
                    marginTop="6px" />

                <brls:Label
                    text="- [X]: Abrir menu de opciones contextuales del archivo seleccionado"
                    fontSize="14px"
                    textColor="#9CA3AF"
                    marginTop="6px" />

                <brls:Label
                    text="- [B]: Volver o subir un nivel en el explorador"
                    fontSize="14px"
                    textColor="#9CA3AF"
                    marginTop="6px" />

                <brls:Label
                    text="- [+]: Salir limpiamente al lanzador Homebrew"
                    fontSize="14px"
                    textColor="#9CA3AF"
                    marginTop="6px" />

                <brls:Header
                    title="Creditos y Agradecimientos"
                    marginTop="18px" />

                <brls:Label
                    text="- Borealis GUI Library por XITRIX"
                    fontSize="14px"
                    textColor="#9CA3AF"
                    marginTop="6px" />

                <brls:Label
                    text="- Atmosphere Haze (Protocolo USB MTP)"
                    fontSize="14px"
                    textColor="#9CA3AF"
                    marginTop="4px" />

                <brls:Label
                    text="- devkitPro, libnx y la comunidad de Homebrew de Nintendo Switch"
                    fontSize="14px"
                    textColor="#9CA3AF"
                    marginTop="4px"
                    marginBottom="10px" />

            </brls:Box>

        </brls:Box>
    </brls:ScrollingFrame>

</brls:Box>
