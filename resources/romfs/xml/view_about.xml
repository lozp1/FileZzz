<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20px"
    paddingLeft="40px"
    paddingRight="40px"
    paddingBottom="20px">

    <brls:Header
        title="Acerca de EzFiles" />
    <brls:Label
        text="Gestor de archivos y servidor de transferencia avanzado para Nintendo Switch"
        fontSize="15px"
        textColor="#9CA3AF"
        marginTop="4px" />

    <brls:ScrollingFrame
        width="auto"
        height="500px"
        marginTop="20px">
        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="center">

            <brls:Image
                image="@res/img/icon_explorer.png"
                width="96px"
                height="96px"
                marginTop="10px"
                marginBottom="15px" />

            <brls:Label
                text="EzFiles"
                fontSize="28px"
                textColor="#06B6D4" />

            <brls:Label
                text="Versión 1.3.0 (Borealis Native UI)"
                fontSize="16px"
                textColor="#10B981"
                marginTop="4px" />

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                marginTop="25px"
                padding="20px"
                cornerRadius="8px"
                backgroundColor="#1A1D24">

                <brls:Label
                    text="Desarrollado por: Paolo"
                    fontSize="16px"
                    textColor="#E5E7EB" />

                <brls:Label
                    text="Motor Gráfico: Borealis (Aceleración por Hardware GPU OpenGL)"
                    fontSize="15px"
                    textColor="#9CA3AF"
                    marginTop="8px" />

                <brls:Label
                    text="Transferencia USB: MTP High-Speed (35 a 45 MB/s) con 8 particiones DBI"
                    fontSize="15px"
                    textColor="#9CA3AF"
                    marginTop="6px" />

                <brls:Label
                    text="Transferencia Red: Servidor FTP concurrente con soporte UTF-8"
                    fontSize="15px"
                    textColor="#9CA3AF"
                    marginTop="6px" />

                <brls:Label
                    text="Controles: Soporte completo para pantalla táctil y Joy-Con / Mandos Pro"
                    fontSize="15px"
                    textColor="#9CA3AF"
                    marginTop="6px" />

            </brls:Box>

        </brls:Box>
    </brls:ScrollingFrame>

</brls:Box>
