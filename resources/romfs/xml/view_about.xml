<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20px"
    paddingLeft="40px"
    paddingRight="40px"
    paddingBottom="20px">

    <brls:Header
        title="Acerca de EzFiles" />
    <brls:Label
        text="Gestor de archivos y servidor de transferencia avanzado para Nintendo Switch"
        fontSize="15px"
        textColor="@theme/brls/header/subtitle"
        marginTop="4px" />

    <brls:ScrollingFrame
        width="auto"
        height="500px"
        marginTop="20px">
        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            alignItems="center">

            <brls:Image
                image="@res/img/ezfiles_logo.png"
                width="110px"
                height="110px"
                cornerRadius="22px"
                marginTop="10px"
                marginBottom="12px" />

            <brls:Label
                text="EzFiles · Andromeda Suite"
                fontSize="26px"
                textColor="#38BDF8" />

            <brls:Label
                text="Version 1.3.0"
                fontSize="15px"
                textColor="@theme/brls/text_disabled"
                marginTop="4px" />

            <brls:Box
                width="auto"
                height="auto"
                axis="column"
                marginTop="20px"
                padding="20px"
                cornerRadius="8px"
                backgroundColor="@theme/brls/sidebar/background">

                <brls:Header
                    title="Informacion del Desarrollador" />

                <brls:Label
                    text="Desarrollador: Franco Paolo Lopez Galvez"
                    fontSize="15px"
                    textColor="@theme/brls/text"
                    marginTop="6px" />

                <brls:Label
                    text="Correo Personal: francopaolo_lg@outlook.com"
                    fontSize="15px"
                    textColor="#38BDF8"
                    marginTop="6px" />

                <brls:Label
                    text="Repositorio GitHub: https://github.com/lozp1"
                    fontSize="15px"
                    textColor="@theme/brls/text"
                    marginTop="6px" />

                <brls:Label
                    text="Plataforma: Horizon OS / Nintendo Switch"
                    fontSize="15px"
                    textColor="@theme/brls/text_disabled"
                    marginTop="6px" />

                <brls:Header
                    title="Caracteristicas del Sistema"
                    marginTop="18px" />

                <brls:Label
                    text="- Explorador nativo con portapapeles (Copiar, Cortar, Pegar), renombrado y eliminacion segura."
                    fontSize="14px"
                    textColor="@theme/brls/text"
                    marginTop="6px" />

                <brls:Label
                    text="- Servidor USB MTP High-Speed (35 a 45 MB/s) con 8 particiones virtuales estandar."
                    fontSize="14px"
                    textColor="@theme/brls/text"
                    marginTop="6px" />

                <brls:Label
                    text="- Servidor FTP Wi-Fi multihilo compatible con clientes estandar (FileZilla, WinSCP, Explorer)."
                    fontSize="14px"
                    textColor="@theme/brls/text"
                    marginTop="6px" />

                <brls:Label
                    text="- Motor grafico Borealis con aceleracion por hardware GPU OpenGL y adaptabilidad a temas."
                    fontSize="14px"
                    textColor="@theme/brls/text"
                    marginTop="6px" />

                <brls:Header
                    title="Controles y Atajos de Mando"
                    marginTop="18px" />

                <brls:Label
                    text="- [A] / Touch: Seleccionar / Entrar a carpeta"
                    fontSize="14px"
                    textColor="@theme/brls/text_disabled"
                    marginTop="6px" />

                <brls:Label
                    text="- [X]: Abrir menu de opciones contextuales del archivo seleccionado"
                    fontSize="14px"
                    textColor="@theme/brls/text_disabled"
                    marginTop="6px" />

                <brls:Label
                    text="- [B]: Volver o subir un nivel en el explorador"
                    fontSize="14px"
                    textColor="@theme/brls/text_disabled"
                    marginTop="6px" />

                <brls:Label
                    text="- [+]: Salir limpiamente de la aplicacion"
                    fontSize="14px"
                    textColor="@theme/brls/text_disabled"
                    marginTop="6px" />

                <brls:Header
                    title="Creditos y Agradecimientos"
                    marginTop="18px" />

                <brls:Label
                    text="- Borealis GUI Library por XITRIX"
                    fontSize="14px"
                    textColor="@theme/brls/text_disabled"
                    marginTop="6px" />

                <brls:Label
                    text="- Atmosphere Haze (Protocolo USB MTP)"
                    fontSize="14px"
                    textColor="@theme/brls/text_disabled"
                    marginTop="4px" />

                <brls:Label
                    text="- devkitPro, libnx y la comunidad de Nintendo Switch"
                    fontSize="14px"
                    textColor="@theme/brls/text_disabled"
                    marginTop="4px"
                    marginBottom="10px" />

            </brls:Box>

        </brls:Box>
    </brls:ScrollingFrame>

</brls:Box>
