<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20px"
    paddingLeft="40px"
    paddingRight="40px"
    paddingBottom="20px">

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        justifyContent="spaceBetween"
        alignItems="center">
        <brls:Label
            id="lblCurrentPath"
            text="sdmc:/"
            fontSize="20px"
            textColor="#38BDF8" />
        <brls:Label
            id="lblItemCount"
            text="0 elementos"
            fontSize="16px"
            textColor="@theme/brls/text_disabled" />
    </brls:Box>

    <brls:ScrollingFrame
        width="auto"
        height="500px"
        marginTop="15px">
        <brls:Box
            id="boxFiles"
            width="auto"
            height="auto"
            axis="column" />
    </brls:ScrollingFrame>
</brls:Box>
