<brls:Box
    xmlns:brls="http://borealis.org/borealis"
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20px"
    paddingLeft="40px"
    paddingRight="40px"
    paddingBottom="20px">

    <brls:Header
        title="Servidor FTP Inalámbrico"
        subtitle="Transfiere archivos mediante Wi-Fi desde cualquier cliente FTP (FileZilla, WinSCP)" />

    <brls:Box
        width="auto"
        height="auto"
        axis="row"
        justifyContent="spaceBetween"
        alignItems="center"
        marginTop="20px"
        padding="20px"
        cornerRadius="8px"
        backgroundColor="#1A1D24">

        <brls:Box axis="column">
            <brls:Label
                id="lblFtpStatus"
                text="Estado: Desactivado"
                fontSize="22px"
                textColor="#8B5CF6" />
            <brls:Label
                id="lblFtpAddress"
                text="Dirección: ftp://0.0.0.0:5000"
                fontSize="16px"
                textColor="#9CA3AF"
                marginTop="6px" />
        </brls:Box>

        <brls:Button
            id="btnToggleFtp"
            text="Iniciar FTP"
            width="200px"
            height="50px" />
    </brls:Box>

    <brls:Header
        title="Instrucciones de Conexión"
        marginTop="30px" />

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        padding="15px"
        cornerRadius="8px"
        backgroundColor="#0F1117">
        <brls:Label
            text="1. Asegúrate de que la Switch y tu PC estén en la misma red Wi-Fi."
            fontSize="16px"
            textColor="#D1D5DB" />
        <brls:Label
            text="2. Abre tu cliente FTP e introduce la IP y el puerto mostrados arriba."
            fontSize="16px"
            textColor="#D1D5DB"
            marginTop="8px" />
        <brls:Label
            text="3. Usuario y contraseña: Dejar en blanco o usar modo anónimo."
            fontSize="16px"
            textColor="#D1D5DB"
            marginTop="8px" />
    </brls:Box>

</brls:Box>
