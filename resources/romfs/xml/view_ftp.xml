<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20px"
    paddingLeft="40px"
    paddingRight="40px"
    paddingBottom="20px">

    <brls:Header
        title="Servidor FTP Inalambrico" />
    <brls:Label
        text="Transfiere archivos mediante Wi-Fi desde cualquier cliente FTP (FileZilla, WinSCP)"
        fontSize="15px"
        textColor="@theme/brls/header/subtitle"
        marginTop="4px" />

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        marginTop="20px"
        padding="20px"
        cornerRadius="8px"
        backgroundColor="@theme/brls/sidebar/background">

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            justifyContent="spaceBetween"
            alignItems="center">

            <brls:Label
                id="lblFtpStatus"
                text="Estado: Desactivado"
                fontSize="22px"
                textColor="#8B5CF6" />

            <brls:Button
                id="btnToggleFtp"
                text="Iniciar FTP"
                width="180px"
                height="44px" />
        </brls:Box>

        <brls:Label
            id="lblFtpAddress"
            text="Direccion: Desconectado"
            fontSize="16px"
            textColor="@theme/brls/text_disabled"
            marginTop="12px" />

    </brls:Box>

    <brls:Header
        title="Instrucciones de Conexion"
        marginTop="25px" />

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        padding="15px"
        cornerRadius="8px"
        backgroundColor="@theme/brls/background">
        <brls:Label
            text="1. Asegurate de que la Switch y tu PC esten en la misma red Wi-Fi."
            fontSize="15px"
            textColor="@theme/brls/text" />
        <brls:Label
            text="2. Abre tu cliente FTP e introduce la IP y el puerto mostrados arriba."
            fontSize="15px"
            textColor="@theme/brls/text"
            marginTop="8px" />
        <brls:Label
            text="3. Usuario y contrasena: Dejar en blanco o usar modo anonimo."
            fontSize="15px"
            textColor="@theme/brls/text"
            marginTop="8px" />
    </brls:Box>

</brls:Box>
