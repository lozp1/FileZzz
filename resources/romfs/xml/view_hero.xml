<brls:Box
    grow="1.0"
    axis="column"
    justifyContent="center"
    alignItems="center">

    <!-- Tarjeta Centrada de Descripción -->
    <brls:Box
        width="600px"
        height="auto"
        axis="column"
        alignItems="center"
        justifyContent="center"
        padding="32px"
        cornerRadius="14px"
        backgroundColor="@theme/brls/sidebar/background">

        <!-- Icono grande de la herramienta -->
        <brls:Image
            id="heroIcon"
            width="88px"
            height="88px"
            marginBottom="16px" />

        <!-- Título de la función -->
        <brls:Label
            id="heroTitle"
            text="Título"
            fontSize="26px"
            textColor="@theme/brls/text"
            horizontalAlign="center"
            marginBottom="12px" />

        <brls:Box
            width="100%"
            height="1px"
            backgroundColor="@theme/brls/sidebar/separator"
            marginBottom="16px" />

        <!-- Descripción detallada centrada -->
        <brls:Label
            id="heroDesc"
            width="520px"
            text="Descripción de la función"
            fontSize="15px"
            lineHeight="1.4"
            textColor="@theme/brls/text_disabled"
            horizontalAlign="center"
            marginBottom="26px" />

        <!-- Botón de Entrada a Pantalla Completa -->
        <brls:Box
            id="btnOpenFeature"
            width="300px"
            height="48px"
            focusable="true"
            cornerRadius="8px"
            backgroundColor="#0284C7"
            justifyContent="center"
            alignItems="center">
            <brls:Label
                id="lblOpenText"
                text="Entrar (A)"
                fontSize="17px"
                textColor="#FFFFFF"
                horizontalAlign="center" />
        </brls:Box>

    </brls:Box>

</brls:Box>
