<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="20px"
    paddingLeft="40px"
    paddingRight="40px"
    paddingBottom="20px">

    <brls:Header
        title="Transferencia USB MTP" />
    <brls:Label
        text="Conecta la consola a tu PC con un cable USB-C de datos"
        fontSize="15px"
        textColor="@theme/brls/header/subtitle"
        marginTop="4px" />

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        marginTop="20px"
        padding="20px"
        cornerRadius="8px"
        backgroundColor="@theme/brls/sidebar/background">

        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            justifyContent="spaceBetween"
            alignItems="center">

            <brls:Label
                id="lblMtpStatus"
                text="Estado: En espera de conexion USB"
                fontSize="22px"
                textColor="#10B981" />

            <brls:Button
                id="btnToggleMtp"
                text="Detener MTP"
                width="180px"
                height="44px" />
        </brls:Box>

        <brls:Label
            id="lblMtpInfo"
            text="8 Particiones: SD, User, System, Juegos, Install SD/NAND, Saves, Album"
            fontSize="16px"
            textColor="@theme/brls/text_disabled"
            marginTop="12px" />

    </brls:Box>

    <brls:Header
        title="Registro de Actividad"
        marginTop="25px" />

    <brls:Box
        id="boxMtpLogs"
        width="auto"
        height="320px"
        axis="column"
        padding="15px"
        cornerRadius="8px"
        backgroundColor="@theme/brls/background">
        <brls:Label
            id="lblLogContent"
            text="[MTP] Servicio iniciado y listo para recibir conexiones."
            fontSize="14px"
            textColor="@theme/brls/text" />
    </brls:Box>

</brls:Box>
