<brls:Box
    width="auto"
    height="auto"
    axis="column"
    paddingTop="25px"
    paddingLeft="40px"
    paddingRight="40px"
    paddingBottom="20px">

    <!-- Encabezado estilo Switch Horizon OS con barra elegante -->
    <brls:Box
        width="100%"
        height="auto"
        axis="column"
        marginBottom="18px">
        <brls:Box
            width="auto"
            height="auto"
            axis="row"
            alignItems="center"
            marginBottom="12px">
            <brls:Rectangle
                width="4px"
                height="22px"
                color="#00F2FE"
                marginRight="12px" />
            <brls:Label
                text="@i18n/hints/settings_title"
                fontSize="24px"
                textColor="@theme/brls/text" />
        </brls:Box>
        <brls:Box
            width="100%"
            height="1px"
            backgroundColor="@theme/brls/sidebar/separator" />
    </brls:Box>

    <brls:ScrollingFrame
        width="auto"
        height="540px">
        <brls:Box
            width="auto"
            height="auto"
            axis="column"
            paddingBottom="35px">

            <!-- Sección: Temas -->
            <brls:Label
                text="@i18n/hints/settings_themes"
                fontSize="18px"
                textColor="@theme/brls/text_disabled"
                marginBottom="12px" />

            <brls:Box
                id="boxThemesList"
                width="auto"
                height="auto"
                axis="column"
                marginBottom="20px" />

            <!-- Sección: Fondo de Pantalla -->
            <brls:Label
                text="@i18n/hints/settings_wallpaper"
                fontSize="18px"
                textColor="@theme/brls/text_disabled"
                marginTop="10px"
                marginBottom="12px" />

            <!-- Fila: Seleccionar Fondo -->
            <brls:Box
                id="rowWallpaper"
                width="100%"
                height="58px"
                focusable="true"
                axis="row"
                alignItems="center"
                justifyContent="spaceBetween"
                paddingLeft="14px"
                paddingRight="14px"
                cornerRadius="4px">
                <brls:Label
                    text="@i18n/hints/wallpaper_select"
                    fontSize="16px"
                    textColor="@theme/brls/text" />
                <brls:Label
                    id="lblWallpaperVal"
                    text="@i18n/hints/wallpaper_default"
                    fontSize="16px"
                    textColor="#00E6A8" />
            </brls:Box>
            <brls:Box width="100%" height="1px" backgroundColor="@theme/brls/sidebar/separator" />

            <!-- Fila: Opacidad -->
            <brls:Box
                id="rowWallpaperOpacity"
                width="100%"
                height="58px"
                focusable="true"
                axis="row"
                alignItems="center"
                justifyContent="spaceBetween"
                paddingLeft="14px"
                paddingRight="14px"
                cornerRadius="4px">
                <brls:Label
                    text="@i18n/hints/wallpaper_opacity"
                    fontSize="16px"
                    textColor="@theme/brls/text" />
                <brls:Label
                    id="lblWallpaperOpacityVal"
                    text="100%"
                    fontSize="16px"
                    textColor="#00E6A8" />
            </brls:Box>
            <brls:Box width="100%" height="1px" backgroundColor="@theme/brls/sidebar/separator" />

            <!-- Sección: Idioma -->
            <brls:Label
                text="@i18n/hints/settings_language"
                fontSize="18px"
                textColor="@theme/brls/text_disabled"
                marginTop="20px"
                marginBottom="12px" />

            <!-- Fila: Idioma -->
            <brls:Box
                id="rowLanguage"
                width="100%"
                height="58px"
                focusable="true"
                axis="row"
                alignItems="center"
                justifyContent="spaceBetween"
                paddingLeft="14px"
                paddingRight="14px"
                cornerRadius="4px">
                <brls:Label
                    text="@i18n/hints/settings_language_app"
                    fontSize="16px"
                    textColor="@theme/brls/text" />
                <brls:Label
                    id="lblLanguageVal"
                    text="Español"
                    fontSize="16px"
                    textColor="#00E6A8" />
            </brls:Box>
            <brls:Box width="100%" height="1px" backgroundColor="@theme/brls/sidebar/separator" />

            <!-- Sección: Servicios de Red y FTP -->
            <brls:Label
                text="Servicios de Red y Servidor FTP"
                fontSize="18px"
                textColor="@theme/brls/text_disabled"
                marginTop="20px"
                marginBottom="12px" />

            <!-- Fila: Puerto FTP -->
            <brls:Box
                id="rowFtpPort"
                width="100%"
                height="58px"
                focusable="true"
                axis="row"
                alignItems="center"
                justifyContent="spaceBetween"
                paddingLeft="14px"
                paddingRight="14px"
                cornerRadius="4px">
                <brls:Label
                    text="@i18n/hints/ftp_port"
                    fontSize="16px"
                    textColor="@theme/brls/text" />
                <brls:Label
                    id="lblFtpPortVal"
                    text="5000"
                    fontSize="16px"
                    textColor="#00E6A8" />
            </brls:Box>
            <brls:Box width="100%" height="1px" backgroundColor="@theme/brls/sidebar/separator" />

            <!-- Fila: Usuario FTP -->
            <brls:Box
                id="rowFtpUser"
                width="100%"
                height="58px"
                focusable="true"
                axis="row"
                alignItems="center"
                justifyContent="spaceBetween"
                paddingLeft="14px"
                paddingRight="14px"
                cornerRadius="4px">
                <brls:Label
                    text="@i18n/hints/ftp_user"
                    fontSize="16px"
                    textColor="@theme/brls/text" />
                <brls:Label
                    id="lblFtpUserVal"
                    text="switch"
                    fontSize="16px"
                    textColor="#00E6A8" />
            </brls:Box>
            <brls:Box width="100%" height="1px" backgroundColor="@theme/brls/sidebar/separator" />

            <!-- Fila: Contraseña FTP -->
            <brls:Box
                id="rowFtpPass"
                width="100%"
                height="58px"
                focusable="true"
                axis="row"
                alignItems="center"
                justifyContent="spaceBetween"
                paddingLeft="14px"
                paddingRight="14px"
                cornerRadius="4px">
                <brls:Label
                    text="@i18n/hints/ftp_pass"
                    fontSize="16px"
                    textColor="@theme/brls/text" />
                <brls:Label
                    id="lblFtpPassVal"
                    text="******"
                    fontSize="16px"
                    textColor="#00E6A8" />
            </brls:Box>
            <brls:Box width="100%" height="1px" backgroundColor="@theme/brls/sidebar/separator" />

        </brls:Box>
    </brls:ScrollingFrame>

</brls:Box>
