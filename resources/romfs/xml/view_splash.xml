<brls:Box
    width="auto"
    height="auto"
    axis="column"
    justifyContent="center"
    alignItems="center"
    grow="1.0"
    backgroundColor="#0F1117">

    <brls:Image
        id="splashLogo"
        image="@res/img/ezfiles_logo.jpg"
        width="220px"
        height="220px"
        cornerRadius="16px" />

    <brls:Label
        id="splashTitle"
        text="EzFiles"
        fontSize="36px"
        textColor="#06B6D4"
        marginTop="24px" />

    <brls:Label
        id="splashSub"
        text="Iniciando sistema..."
        fontSize="15px"
        textColor="#9CA3AF"
        marginTop="8px" />

</brls:Box>
