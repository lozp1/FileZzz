<brls:Box
    id="splashContainer"
    width="auto"
    height="auto"
    axis="column"
    justifyContent="center"
    alignItems="center"
    grow="1.0"
    backgroundColor="#0F1117">

    <brls:Image
        id="splashLogo"
        image="@res/img/ezfiles_logo.png"
        width="220px"
        height="220px"
        cornerRadius="28px" />

    <brls:Label
        id="splashTitle"
        text="EzFiles"
        fontSize="36px"
        textColor="#38BDF8"
        marginTop="24px" />

    <brls:Label
        id="splashSub"
        text="Andromeda Suite"
        fontSize="16px"
        textColor="#9CA3AF"
        marginTop="8px" />

</brls:Box>
