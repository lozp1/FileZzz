<brls:Box
    width="auto"
    height="auto"
    axis="column"
    justifyContent="center"
    alignItems="center"
    grow="1.0"
    backgroundColor="#0F1117">

    <brls:Image
        image="@res/img/icon_explorer.png"
        width="160px"
        height="160px" />

    <brls:Label
        text="EzFiles"
        fontSize="40px"
        textColor="#06B6D4"
        marginTop="20px" />

    <brls:Label
        text="Cargando entorno gráfico..."
        fontSize="16px"
        textColor="#9CA3AF"
        marginTop="10px" />

    <brls:ProgressSpinner
        width="40px"
        height="40px"
        marginTop="30px" />

</brls:Box>
